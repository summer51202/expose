AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=your-admin-name
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=file:./dev.db
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Private bucket for photo originals (no public access, no r2.dev, no custom domain).
# Required when STORAGE_BACKEND=r2: uploads fail without it. Local storage uses storage/private/.
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
COMMENT_IDENTITY_SECRET=replace-with-a-long-random-secret
SITE_URL=http://localhost:3000
# Google Search Console HTML-tag verification: the content="..." value only.
GOOGLE_SITE_VERIFICATION=
